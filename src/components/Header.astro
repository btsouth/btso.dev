---
import { releases } from '../lib/ship';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { key: 'ship', label: 'Ship log', href: '/ship' },
  { key: 'omarchy', label: 'Omarchy', href: '/omarchy' },
  { key: 'apps', label: 'Apps', href: '/#apps', wide: true },
];
const active = (href: string) => !href.includes('#') && (path === href || path.startsWith(`${href}/`));
// Release times for the "new since your last visit" badge.
const releaseTimes = JSON.stringify(releases.slice(0, 60).map((r) => Date.parse(r.at)));
---
<header class="hdr" id="hdr">
  <div class="wrap">
    <a class="logo" href="/" aria-label="btso.dev home">
      <span class="logo-mark" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
      <span>btso<span class="dot">.</span>dev</span>
    </a>
    <nav class="nav" aria-label="Primary navigation">
      {nav.map((item) => (
        <a href={item.href} class:list={[{ keep: !item.wide, on: active(item.href) }]} aria-current={active(item.href) ? 'page' : undefined}>
          {item.label}{item.key === 'ship' && <span class="count" id="navCount" data-release-times={releaseTimes} hidden></span>}
        </a>
      ))}
    </nav>
    <div class="hdr-right">
      <div class="theme-wrap">
        <button class="icon-btn" id="themeBtn" type="button" aria-haspopup="true" aria-expanded="false" title="Change theme (T)">
          <span class="swatches" aria-hidden="true"><i style="background:var(--accent)"></i><i style="background:var(--accent2)"></i><i style="background:var(--fg)"></i></span>
          <span id="themeName" class="hide-sm">btso</span>
          <kbd class="hide-sm">T</kbd>
        </button>
        <div class="theme-menu" id="themeMenu" role="menu"></div>
      </div>
      <a class="icon-btn hide-xs" href="https://github.com/btsouth" target="_blank" rel="noreferrer" aria-label="GitHub">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
      </a>
      <a class="icon-btn hide-sm" href="mailto:tyler@btso.dev">Say hello</a>
    </div>
  </div>
</header>
