---
interface Props { count: number; animate?: boolean }
const { count, animate } = Astro.props;
---
<span class="star" aria-label={`${count} GitHub stars`}>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z" /></svg>
  {animate ? <span data-count={count}>{count.toLocaleString('en-US')}</span> : count.toLocaleString('en-US')}
</span>
