---
import { SITE_URL, SITE_NAME, TWITTER } from '../lib/site';
import { ogImage } from '../lib/og';

const DEFAULT_IMAGE = ogImage('/og/home.png');
const DEFAULT_ALT = 'Tyler South on btso.dev: a grid of GitHub activity next to the line "I make software I want on my own computer."';

export interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  path?: string;
  siteName?: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  image = DEFAULT_IMAGE,
  imageAlt = DEFAULT_ALT,
  type = 'website',
  path,
  siteName = SITE_NAME,
  schema = [],
  noindex = false,
} = Astro.props;

const canonicalPath = path ?? Astro.url.pathname;
const url = canonicalPath === '/' ? `${SITE_URL}/` : new URL(canonicalPath, SITE_URL).href;

const graph = [
  {
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: title,
    description,
    isPartOf: { '@type': 'WebSite', '@id': `${SITE_URL}/#website`, name: SITE_NAME, url: SITE_URL },
    publisher: {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: SITE_NAME,
      url: SITE_URL,
    },
  },
  ...schema,
];

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <meta name="robots" content="index, follow, max-image-preview:large" />}

<meta property="og:site_name" content={siteName} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={TWITTER} />
<meta name="twitter:creator" content={TWITTER} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />

<script type="application/ld+json" set:html={jsonLd} />
