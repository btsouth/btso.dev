---
// A small playable Family Bakery board: tap the bread box for an egg, drag two
// matches together, serve the order. Played by scripts/bakery.ts.
import { ART, CHAIN, ORDERS, startBoard } from '../lib/bakery';
import '../styles/bakery.css';

const first = ORDERS[0];
const board = startBoard();
---
<div class="fbt" id="bakery" data-bakery>
  <div class="fbt-bg" aria-hidden="true"></div>
  <div class="fbt-head">
    <div class="fbt-order" data-order>
      <img class="fbt-who" src={`${ART}/${first.who}.webp`} alt="" width="52" height="52" />
      <div class="fbt-say"><p>{first.say}</p><span class="fbt-want"><img src={`${ART}/item-${first.tier}.webp`} alt="" width="34" height="34" /><b>{CHAIN[first.tier - 1]}</b></span></div>
      <button type="button" class="fbt-serve" disabled>Serve</button>
    </div>
    <span class="fbt-coins" title="Coins earned"><img src={`${ART}/coin.webp`} alt="" width="20" height="20" /><b data-coins>0</b></span>
  </div>
  <div class="fbt-board" role="group" aria-label="Merge board">
    {board.map((t, i) => (
      <button type="button" class:list={['cell', { oven: t === -1 }]} data-i={i} aria-label={t === -1 ? 'Bread box: tap for an egg' : t ? CHAIN[t - 1] : 'Empty'}>
        {t === -1 ? <img src={`${ART}/oven.webp`} alt="" width="108" height="99" /> : t ? <img src={`${ART}/item-${t}.webp`} alt="" width="108" height="108" /> : null}
      </button>
    ))}
  </div>
  <p class="fbt-hint" data-hint>Tap the bread box for an egg, then drag two matches together.</p>
  <img class="fbt-cat" src={`${ART}/cat-loaf.webp`} alt="" width="192" height="192" loading="lazy" />
  <p class="sr-only" aria-live="polite" data-say></p>
</div>

<script>
  import '../scripts/bakery';
</script>
