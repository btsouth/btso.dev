---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Stars from '../components/Stars.astro';
import Ticks from '../components/Ticks.astro';
import Version from '../components/Version.astro';
import PixelThumb from '../components/PixelThumb.astro';
import { projectById, projects, releases, within } from '../lib/ship';
import { ogImage } from '../lib/og';

const lead = projectById['try-omarchy'];
const omarchy = projects.filter((p) => p.group === 'omarchy');
const list = omarchy
  .filter((p) => p.id !== lead.id)
  .sort((a, b) => b.stars - a.stars || (b.releasedAt ?? '').localeCompare(a.releasedAt ?? ''));
const totalStars = omarchy.reduce((n, p) => n + p.stars, 0);
const monthReleases = releases.filter((r) => r.project.group === 'omarchy' && within(r.at, 30)).length;
---
<Base title="Omarchy apps and plugins | btso.dev" description="Apps, bar widgets and plugins for Omarchy: Try Omarchy for Windows, Omakade, Omaroll, Agent Pulse, Omalink and more." path="/omarchy" image={ogImage('/og/omarchy.png')} imageAlt="Omarchy apps and plugins by Tyler South">
  <section class="page-head">
    <div class="px-band" id="pxBand" aria-hidden="true"></div>
    <div class="wrap" style="position:relative">
      <p class="eyebrow">For Omarchy</p>
      <h1>Omarchy things</h1>
      <p>Apps, bar widgets and plugins I've built for Omarchy. They all follow your system theme. Press <kbd>T</kbd> to see this page wear a few of them.</p>
      <div class="row"><span class="meta"><Stars count={totalStars} /><span>{omarchy.length} projects</span><span>{monthReleases} releases this month</span></span></div>
    </div>
  </section>

  <div class="wrap">
    <article class="lead glow rv" style={`--pc:${lead.accent}`}>
      <div class="fshot"><div class="win"><div class="bar"><i></i><i></i><i></i></div><img src={lead.shot} alt="Omarchy running in a window on Windows" width="1200" height="674" /></div></div>
      <div class="fbody">
        <span class="lead-tag" style="align-self:flex-start">Most popular</span>
        <div class="row"><Icon project={lead} size="lg" /><h3>{lead.name} for Windows</h3></div>
        <div class="meta"><Stars count={lead.stars} animate /><Version project={lead} /><span>under the omacom org</span></div>
        <p>{lead.tagline} No repartitioning, no dual boot. If you want to see what the fuss is about, start here.</p>
        <div class="acts"><a class="btn btn-primary" href={lead.site} target="_blank" rel="noreferrer">Try Omarchy <span class="arr">→</span></a><a class="btn btn-ghost" href={`/p/${lead.id}`}>Changelog</a></div>
      </div>
    </article>

    <section class="blk" style="padding-top:56px">
      <div class="blk-head rv"><div><h2>Apps and plugins</h2><p>Sorted by stars. Open any card for its full changelog, or copy the install command.</p></div></div>
      <div class="pgrid">
        {list.map((p) => (
          <article class="pcard glow rv" style={`--pc:${p.accent}`}>
            <a class="thumb" href={`/p/${p.id}`} aria-label={`${p.name} details`}>
              {p.shot ? <img src={p.shot} alt="" loading="lazy" /> : <PixelThumb project={p} />}
            </a>
            <div class="pb">
              <h4><Icon project={p} size="sm" /><a href={`/p/${p.id}`}>{p.name}</a><Stars count={p.stars} /></h4>
              <p>{p.tagline}</p>
              <div class="pf">
                <Ticks project={p} />
                <div class="meta"><Version project={p} /></div>
                {p.install
                  ? <button type="button" class="copy" data-copy={p.install}><span class="p">$</span><code>{p.install}</code><span class="c">copy</span></button>
                  : <a class="copy" href={`https://github.com/${p.repo}`} target="_blank" rel="noreferrer"><span class="p">↗</span><code>github.com/{p.repo}</code><span class="c">open</span></a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</Base>

<script>
  import '../scripts/pixel-band';
</script>
