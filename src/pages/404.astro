---
import Base from '../layouts/Base.astro';
import { releases } from '../lib/ship';
import { ago } from '../lib/time';
import { textShape } from '../scripts/pixel-font';

// A pixel sign in the hero's style. Clicking it cycles through these words.
const WORDS = ['404', 'LOST?', 'HI :)'];
const COLS = Math.max(...WORDS.map((w) => textShape(w)!.cols));
const lit = new Set(textShape(WORDS[0])!.lit.map(([x, y]) => `${x + Math.floor((COLS - textShape(WORDS[0])!.cols) / 2)},${y}`));
const latest = releases[0];
---
<Base title="Not found | btso.dev" description="The page you were looking for could not be found." noindex={true}>
  <section class="lost wrap">
    <button type="button" class="px-sign" id="pxSign" data-words={JSON.stringify(WORDS)} data-cols={COLS} style={`--cols:${COLS}`} aria-label="404">
      {Array.from({ length: COLS * 7 }, (_, i) => <i class={lit.has(`${i % COLS},${Math.floor(i / COLS)}`) ? 'on' : ''}></i>)}
    </button>
    <h1>This page never shipped.</h1>
    <p>Nothing lives at this address. Everything that did ship is in the ship log.</p>
    <div class="ctas"><a class="btn btn-primary" href="/ship">See what shipped <span class="arr">→</span></a><a class="btn btn-ghost" href="/#apps">All the apps</a></div>
    {latest && <a class="pill" href={`/p/${latest.project.id}`}><span class="live"></span><span><b style="color:var(--fg)">{latest.project.name} {latest.tag}</b> shipped <span data-ago={latest.at}>{ago(latest.at)}</span></span><span class="arr">→</span></a>}
  </section>
</Base>

<style>
  .lost { min-height: 62vh; padding: 88px 0 40px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; }
  .px-sign { display: grid; grid-template-columns: repeat(var(--cols), 1fr); gap: 5px; width: min(100%, calc(var(--cols) * 26px)); margin-bottom: 18px; cursor: pointer; }
  .px-sign i { aspect-ratio: 1; border-radius: 3px; background: var(--bg3); transition: background .35s, transform .35s cubic-bezier(.2,.8,.2,1); transition-delay: var(--dl, 0s); }
  .px-sign i.on { background: var(--accent); }
  .px-sign i:hover { background: var(--accent2); transform: scale(1.15); transition-delay: 0s; }
  h1 { margin: 0; font: 700 clamp(28px, 4.4vw, 46px)/1.1 "JetBrains Mono", monospace; letter-spacing: -.035em; }
  .lost > p { margin: 0; max-width: 46ch; color: var(--fg2); font-size: 17px; }
  .ctas { margin-top: 10px; }
  .pill { margin-top: 26px; }
</style>

<script>
  import { textShape } from '../scripts/pixel-font';

  const sign = document.getElementById('pxSign');
  if (sign) {
    const words: string[] = JSON.parse(sign.dataset.words ?? '[]');
    const cols = Number(sign.dataset.cols);
    const cells = [...sign.querySelectorAll<HTMLElement>('i')];
    let n = 0;
    sign.addEventListener('click', () => {
      const word = words[++n % words.length];
      const shape = textShape(word)!;
      const off = Math.floor((cols - shape.cols) / 2);
      const on = new Set(shape.lit.map(([x, y]) => (x + off) + y * cols));
      // A left-to-right wipe from the new word's first column.
      cells.forEach((c, i) => { c.style.setProperty('--dl', `${(i % cols) * 18}ms`); c.classList.toggle('on', on.has(i)); });
      sign.setAttribute('aria-label', word);
    });
  }
</script>
