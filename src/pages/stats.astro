---
import Base from '../layouts/Base.astro';
import AiTabs from '../components/AiTabs.astro';
import Icon from '../components/Icon.astro';
import usage from '../data/usage.json';
import { projectById } from '../lib/ship';
import { modelColor, short, money, dayLabel, OTHER } from '../lib/ai';
import { ogImage } from '../lib/og';
import '../styles/ai.css';

const t = usage.totals;
const models = usage.models.filter((m) => m.name !== 'Unknown');
const updated = new Date(usage.updated);

// Calendar: whole weeks from the Sunday before the first day to today.
const byDay = new Map(usage.days.map((d) => [d.d, d]));
const iso = (d: Date) => d.toISOString().slice(0, 10);
const first = new Date(`${usage.first}T12:00:00Z`);
const start = new Date(first);
start.setUTCDate(start.getUTCDate() - start.getUTCDay());
const end = new Date(`${usage.updated.slice(0, 10)}T12:00:00Z`);
const maxDay = Math.max(...usage.days.map((d) => d.t));
const cells: { d: string; l: number; pad: boolean }[] = [];
for (const d = new Date(start); d <= end; d.setUTCDate(d.getUTCDate() + 1)) {
  const key = iso(d);
  const day = byDay.get(key);
  const pad = key < usage.first;
  cells.push({ d: key, pad, l: day && day.t ? Math.max(1, Math.ceil((day.t / maxDay) * 4)) : 0 });
}

// The last 60 days of the daily chart.
const recent = usage.days.slice(-60);
const recentMax = Math.max(...recent.map((d) => d.t));
const legendTotals = new Map<string, number>();
for (const d of recent) for (const [name, n] of Object.entries(d.m)) legendTotals.set(name, (legendTotals.get(name) ?? 0) + (n as number));
const legendNames = [...legendTotals.entries()].sort((a, b) => (a[0] === 'Other' ? 1 : b[0] === 'Other' ? -1 : b[1] - a[1])).map(([n]) => n);
const colorOf = (name: string) => (name === 'Other' ? OTHER : modelColor(name));

const projects = usage.projects30.map((p) => ({ ...p, project: projectById[p.id] })).filter((p) => p.project);
const projMax = projects[0]?.tokens ?? 1;

const bars30 = models.filter((m) => m.tokens30 > 0).sort((a, b) => b.tokens30 - a.tokens30).slice(0, 8);
const barMax = bars30[0]?.tokens30 ?? 1;

const clientData = JSON.stringify({ days: usage.days, models }).replace(/</g, '\\u003c');
---
<Base title="My AI usage | btso.dev" description="How much AI coding I actually do: tokens, models and what it would cost at API prices, from my own logs." path="/stats" image={ogImage('/og/stats.png')} imageAlt="My AI coding usage on btso.dev">
  <section class="page-head">
    <div class="px-band" id="pxBand" aria-hidden="true"></div>
    <div class="wrap" style="position:relative">
      <p class="eyebrow"><span class="live"></span> Updated nightly from my own logs</p>
      <h1>My AI usage</h1>
      <p>Every number here comes from the logs my coding agents already keep. It's numbers only: no prompts, no code and no private projects. Work accounts aren't counted.</p>
      <div class="row"><AiTabs /><span class="ai-note">since {dayLabel(usage.first, { month: 'long', day: 'numeric', year: 'numeric' })} · updated <span data-ago={usage.updated}>{updated.toLocaleDateString('en-US')}</span></span></div>
    </div>
  </section>

  <div class="wrap">
    <div class="ai-nums">
      <div class="bn rv"><span>tokens in the last 30 days<br /><em>{short(t.tokens)} since day one</em></span><b data-num={t.tokens30} data-fmt="short">{short(t.tokens30)}</b></div>
      <div class="bn rv"><span>of work at API list prices, last 30 days<br /><em>{money(t.value)} in total</em></span><b data-num={t.value30} data-fmt="money">{money(t.value30)}</b></div>
      <div class="bn rv"><span>days in a row with AI coding<br /><em>longest run {t.longestStreak} days</em></span><b data-num={t.streak} data-fmt="int">{t.streak}</b></div>
      <div class="bn rv"><span>of input tokens served from cache<br /><em>{short(t.output)} written fresh</em></span><b data-num={t.cacheShare * 100} data-fmt="pct">{(t.cacheShare * 100).toFixed(1)}%</b></div>
    </div>

    <div class="panel rv tipbox" id="calPanel">
      <div class="panel-h">
        <div><h3>Every day, every token</h3><p>One square per day. Hover a day to see what ran.</p></div>
      </div>
      <div class="cal-layout">
        <div class="cal-wrap" style={`--weeks:${Math.ceil(cells.length / 7)}`}>
          <div class="cal-days" aria-hidden="true">{['', 'Mon', '', 'Wed', '', 'Fri', ''].map((d) => <span>{d}</span>)}</div>
          <div class="cal" id="cal" role="img" aria-label={`Daily token use since ${usage.first}`}>
            {cells.map((c) => <i class:list={{ pad: c.pad }} data-d={c.d} data-l={c.l}></i>)}
          </div>
        </div>
        <dl class="facts">
          <div><dt>Busiest day</dt><dd>{short(t.busiestDay.tokens)}<small>{dayLabel(t.busiestDay.date)}</small></dd></div>
          <div><dt>Average active day</dt><dd>{short(t.tokens / Math.max(1, t.activeDays))}<small>{money(t.value / Math.max(1, t.activeDays))} at API prices</small></dd></div>
          <div><dt>Sessions</dt><dd>{t.sessions.toLocaleString('en-US')}<small>{t.sessions30.toLocaleString('en-US')} this month</small></dd></div>
          <div><dt>Model calls</dt><dd>{short(t.calls)}<small>{short(t.calls30)} this month</small></dd></div>
        </dl>
      </div>
      <div class="cal-foot">
        <span class="ai-note">{t.activeDays} active days since {dayLabel(usage.first)}</span>
        <span class="cal-key">less <i style="background:var(--bg3)"></i>{[1, 2, 3, 4].map((l) => <i data-l={l} style={`background:color-mix(in oklab, var(--accent) ${[28, 50, 74, 100][l - 1]}%, var(--bg3))`}></i>)} more</span>
      </div>
      <div class="tip" id="calTip"></div>
    </div>

    <section class="ai-sec">
      <div class="blk-head rv"><div><p class="eyebrow">Models</p><h2>Who does the work</h2><p>Which models my agents ran. Switch to API value to see what the same tokens would cost at each model's list price.</p></div></div>

      <div class="panel rv" id="modelPanel">
        <div class="panel-h">
          <div class="chips" role="group" aria-label="Range">
            <button type="button" class="chip on" data-range="30">Last 30 days</button>
            <button type="button" class="chip" data-range="all">All time</button>
          </div>
          <div class="chips" role="group" aria-label="Measure">
            <button type="button" class="chip on" data-metric="tokens">Tokens</button>
            <button type="button" class="chip" data-metric="value">API value</button>
          </div>
        </div>
        <div class="mbars" id="mbars">
          {bars30.map((m) => (
            <div class="mbar" style={`--pc:${modelColor(m.name)};--w:${(m.tokens30 / barMax) * 100}%`}>
              <span class="nm"><i></i><span>{m.name}</span></span>
              <span class="track"><span class="fill" style="display:block"></span></span>
              <span class="val">{short(m.tokens30)}<small>{money(m.value30)}</small></span>
            </div>
          ))}
        </div>
      </div>

      <div class="panel rv tipbox">
        <div class="panel-h"><div><h3>Day by day</h3><p>Tokens per day for the last {recent.length} days, split by model. Hover a day for the breakdown.</p></div></div>
        <div class="daily" id="daily">
          {recent.map((d) => (
            <div class="col" data-d={d.d} style={`height:${Math.max(0.5, (d.t / recentMax) * 100)}%`}>
              {Object.entries(d.m).map(([name, n]) => <i style={`--pc:${colorOf(name)};height:${((n as number) / d.t) * 100}%`}></i>)}
            </div>
          ))}
        </div>
        <div class="daily-x"><span>{dayLabel(recent[0].d)}</span><span>{dayLabel(recent[Math.floor(recent.length / 2)].d)}</span><span>{dayLabel(recent.at(-1)!.d)}</span></div>
        <div class="legend">{legendNames.map((n) => <span style={`--pc:${colorOf(n)}`}><i></i>{n}</span>)}</div>
        <div class="tip" id="dailyTip"></div>
      </div>
    </section>

    {projects.length > 0 && (
      <section class="ai-sec">
        <div class="blk-head rv"><div><p class="eyebrow">Projects</p><h2>What it went into</h2><p>The public apps on this site that took the most tokens in the last 30 days. Private and work projects are never named.</p></div></div>
        <div class="pcards">
          {projects.map((p, i) => (
            <a class="pc glow rv" href={`/p/${p.id}`} style={`--pc:${p.project.accent};--w:${(p.tokens / projMax) * 100}%;transition-delay:${i * 40}ms`}>
              <span class="top"><Icon project={p.project} /><span class="rank">#{i + 1}</span></span>
              <b>{p.project.name}</b>
              <span class="n">{short(p.tokens)} tokens</span>
              <span class="b"><i></i></span>
            </a>
          ))}
        </div>
      </section>
    )}

    <p class="ai-note rv" style="margin-top:40px">
      Collected each night by <a href="https://github.com/btsouth/btso.dev/tree/main/scripts/usage" target="_blank" rel="noreferrer">a small script</a> on top of <a href="/p/agent-pulse">Agent Pulse</a>'s log parsers and prices.
      {t.unpricedShare > 0.001 && ` ${(t.unpricedShare * 100).toFixed(1)}% of tokens had no list price and count as $0.`}
      Want yours? <a href="https://stackreplay.com" target="_blank" rel="noreferrer">StackReplay</a> reads the same logs in your browser.
    </p>
  </div>

  <script type="application/json" id="usageData" set:html={clientData}></script>
</Base>

<script>
  import '../scripts/pixel-band';
  import '../scripts/stats';
</script>
