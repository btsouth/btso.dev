---
import Base from '../../layouts/Base.astro';
import Chart107InteractiveChart from '../../components/Chart107InteractiveChart.astro';
import Chart107MetarWidget from '../../components/Chart107MetarWidget.astro';
import { APP_STORE, ART, CHART107_LESSONS, PLAY_STORE, SUPPORT_EMAIL } from '../../lib/chart107';
import { SITE_URL } from '../../lib/site';

const heroLesson = CHART107_LESSONS[0];
const shots = [
  ['charts', 'Interactive FAA Figure 24 sectional chart lesson with Class D callout'],
  ['metar', 'Interactive METAR token decoder with 14 CFR 107.51 ceiling math'],
  ['signs', 'Vector FAA airport signs and runway markings trainer'],
  ['exam', '60-question timed Part 107 Knowledge Test simulator and ACS domains'],
  ['pro', 'Free vs Pro comparison table with one-time $14.99 unlock'],
];

const appSchema = {
  '@type': 'MobileApplication',
  name: 'Chart107: Part 107 Test Prep',
  operatingSystem: 'iOS, Android',
  applicationCategory: 'EducationalApplication',
  url: `${SITE_URL}/chart107`,
  image: `${SITE_URL}${ART}/og.jpg`,
  author: { '@id': `${SITE_URL}/#person` },
  offers: [
    { '@type': 'Offer', price: '0', priceCurrency: 'USD', description: 'Free tier with 3 chart lessons, 112 questions, all trainers, and 1 mock exam' },
    { '@type': 'Offer', price: '14.99', priceCurrency: 'USD', description: 'One-time Pro unlock, no subscription' },
  ],
  sameAs: [APP_STORE, PLAY_STORE],
};
---
<Base
  title="Chart107: FAA Part 107 Sectional Chart & Test Prep | btso.dev"
  description="Interactive FAA Part 107 sectional chart trainer, METAR token decoder, airport signs drills, and 480 FAA-cited exam questions. Pay $14.99 once, no subscription, 100% offline."
  path="/chart107"
  image={`${SITE_URL}${ART}/og.jpg`}
  imageAlt="Chart107: FAA Part 107 interactive sectional charts, METAR decoder, and 480 cited questions."
  schema={[appSchema]}
>
  <section class="c107-hero">
    <div class="wrap c107-hero-grid">
      <div class="c107-copy">
        <img class="c107-icon" src={`${ART}/icon.webp`} alt="" width="76" height="76" />
        <p class="eyebrow">FAA Part 107 · iPhone &amp; Android</p>
        <h1>Chart107</h1>
        <p class="lede">
          Read FAA sectional charts like the real Part 107 test does. Tap real FAA-CT-8080-2H airspace rings, decode METARs token-by-token, and drill 480 FAA-cited questions offline — for <b>$14.99 once</b>, no subscription.
        </p>
        <div class="acts">
          <a class="btn btn-primary" href={APP_STORE} target="_blank" rel="noreferrer">App Store <span class="arr">↗</span></a>
          <a class="btn btn-ghost" href={PLAY_STORE} target="_blank" rel="noreferrer">Google Play ↗</a>
        </div>
        <ul class="facts">
          <li><b>Generous free tier</b>3 full sectional chart lessons, 15 Chart Gauntlet targets, all 3 visual trainers, 112 practice questions, and 1 full 60-question timed mock exam free.</li>
          <li><b>$14.99 once, keep forever</b>Less than 1/11th of one $175 FAA retest fee. No monthly subscription, no user account, works 100% offline.</li>
          <li><b>Built on real FAA figures</b>Uses public-domain FAA-CT-8080-2H Testing Supplement figures and FAA-S-ACS-10B codes (<a href="/chart107/privacy">privacy policy</a>).</li>
        </ul>
      </div>
      <div class="c107-demo">
        <p class="c107-try">Try it live: tap any airspace beacon on FAA Figure 24</p>
        <Chart107InteractiveChart lesson={heroLesson} compact />
      </div>
    </div>
  </section>

  <section class="blk wrap" id="metar">
    <div class="blk-head rv">
      <div>
        <p class="eyebrow">Interactive Weather Lab</p>
        <h2>Part 107 METAR Token Decoder</h2>
        <p>Tap any weather token to decode winds, visibility, ceilings, and automatic 14 CFR §107.51(c) max drone altitude limits.</p>
      </div>
    </div>
    <Chart107MetarWidget />
  </section>

  <section class="blk wrap" id="figures">
    <div class="blk-head rv">
      <div>
        <p class="eyebrow">FAA-CT-8080-2H Testing Supplement</p>
        <h2>All 12 Interactive Sectional Chart Guides</h2>
        <p>Every high-yield FAA sectional figure tested on the Part 107 (UAG) exam, with tappable airspace floors, ceilings, LAANC rules, and exam traps.</p>
      </div>
    </div>
    <div class="c107-fig-grid">
      {CHART107_LESSONS.map((lesson) => (
        <a class="c107-fig-card" href={`/chart107/figures/${lesson.slug}`}>
          <div class="c107-fig-top">
            <span class="c107-fig-num">{lesson.figureLabel}</span>
            <span class:list={['c107-fig-tag', lesson.freeTier && 'is-free']}>
              {lesson.freeTier ? 'FREE IN APP' : `${lesson.hotspots.length} HOTSPOTS`}
            </span>
          </div>
          <h3>{lesson.title}</h3>
          <p>{lesson.subtitle}</p>
          <span class="c107-fig-link">Open interactive guide →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="blk wrap">
    <div class="blk-head rv">
      <div>
        <p class="eyebrow">Inside the App</p>
        <h2>Built for Passing on Attempt #1</h2>
        <p>High-contrast cockpit dark mode, pinch-zoom sectional charts, spaced repetition, and a realistic 2-hour PSI exam simulator.</p>
      </div>
    </div>
    <div class="c107-shots rv">
      {shots.map(([id, alt]) => <img src={`${ART}/shot-${id}.webp`} alt={alt} width="480" height="1040" loading="lazy" />)}
    </div>
  </section>

  <section class="blk wrap" id="help">
    <div class="blk-head rv"><div><p class="eyebrow">FAQ &amp; Support</p><h2>Common Questions</h2></div></div>
    <div class="c107-help">
      <article class="rv">
        <h3>Is Chart107 a subscription?</h3>
        <p>No. You can try 3 full chart lessons, 112 FAA-cited questions, all visual trainers (METAR, signs, load factor), and 1 complete 60-question timed mock exam free. Unlocking everything is a single $14.99 one-time purchase.</p>
      </article>
      <article class="rv">
        <h3>Does it work offline?</h3>
        <p>Yes. All 12 FAA sectional chart figures, 480 questions, 40 flashcards, and trainers are bundled directly inside the app. Only optional live METAR lookups and initial purchase/restore need internet.</p>
      </article>
      <article class="rv">
        <h3>How do I restore Pro on a new phone?</h3>
        <p>Open the Readiness tab and tap Restore while signed in to the same Apple ID or Google Play account you purchased with.</p>
      </article>
      <article class="rv">
        <h3>Spotted a question or chart issue?</h3>
        <p>Tap "Report issue" inside any question or chart pin, or email <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>. Details on data handling are in the <a href="/chart107/privacy">privacy policy</a>.</p>
      </article>
    </div>
  </section>
</Base>

<style>
  .c107-hero { position: relative; padding: 64px 0 44px; border-bottom: 1px solid var(--line); overflow: hidden; }
  .c107-hero::before { content: ""; position: absolute; inset: 0; z-index: -1; background: radial-gradient(760px 520px at 78% 35%, color-mix(in oklab, #38bdf8 18%, transparent), transparent 72%); }
  .c107-hero-grid { display: grid; grid-template-columns: 1fr 1.08fr; gap: 48px; align-items: start; }
  .c107-icon { width: 76px; height: 76px; border-radius: 18px; box-shadow: 0 12px 30px var(--shade); margin-bottom: 20px; }
  .c107-copy .eyebrow { color: #38bdf8; }
  .c107-copy h1 { margin: 0; font: 700 clamp(44px, 6vw, 70px)/1 "JetBrains Mono", monospace; letter-spacing: -0.05em; }
  .lede { margin: 18px 0 0; max-width: 52ch; color: var(--fg2); font-size: 17px; line-height: 1.6; }
  .c107-copy .acts { display: flex; gap: 10px; margin-top: 24px; flex-wrap: wrap; }
  .facts { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 12px; max-width: 54ch; }
  .facts li { padding: 12px 14px; border-radius: 12px; border: 1px solid var(--line); background: var(--bg2); color: var(--fg2); font-size: 14px; line-height: 1.5; }
  .facts b { display: block; margin-bottom: 2px; color: var(--fg); font: 600 13px/1.4 "JetBrains Mono", monospace; }
  .facts a, .c107-help a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .c107-try { margin: 0 0 12px; text-align: center; font: 600 12px/1 "JetBrains Mono", monospace; color: #38bdf8; }
  .c107-fig-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .c107-fig-card {
    padding: 18px 20px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: var(--bg2);
    text-decoration: none;
    display: grid;
    gap: 8px;
    align-content: start;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .c107-fig-card:hover { border-color: #38bdf8; transform: translateY(-2px); }
  .c107-fig-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .c107-fig-num { font: 800 12px/1 "JetBrains Mono", monospace; color: #38bdf8; letter-spacing: 0.04em; text-transform: uppercase; }
  .c107-fig-tag { padding: 3px 8px; border-radius: 999px; background: var(--bg); border: 1px solid var(--line); color: var(--fg3); font: 700 10.5px/1 "JetBrains Mono", monospace; }
  .c107-fig-tag.is-free { background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.4); color: #10b981; }
  .c107-fig-card h3 { margin: 0; font: 700 16px/1.3 "JetBrains Mono", monospace; color: var(--fg); }
  .c107-fig-card p { margin: 0; font-size: 13.5px; line-height: 1.5; color: var(--fg2); }
  .c107-fig-link { font: 700 12.5px/1 "JetBrains Mono", monospace; color: #38bdf8; margin-top: 4px; }
  .c107-shots { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(195px, 1fr); gap: 14px; overflow-x: auto; padding-bottom: 10px; scroll-snap-type: x mandatory; }
  .c107-shots img { width: 100%; height: auto; border-radius: 16px; border: 1px solid var(--line); scroll-snap-align: start; background: #080f1c; }
  .c107-help { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .c107-help article { padding: 22px 24px; border-radius: 16px; border: 1px solid var(--line); background: var(--bg2); }
  .c107-help h3 { margin: 0 0 8px; font: 700 16px/1.3 "JetBrains Mono", monospace; }
  .c107-help p { margin: 0; color: var(--fg2); line-height: 1.65; }
  @media (max-width: 960px) {
    .c107-hero-grid { grid-template-columns: 1fr; gap: 36px; }
    .c107-fig-grid { grid-template-columns: 1fr 1fr; }
    .c107-help { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .c107-fig-grid { grid-template-columns: 1fr; }
    .c107-shots { grid-auto-columns: 66%; }
  }
</style>
