{
  "headers": [
    { "source": "/_astro/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(assets|images|icons)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/og/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com; connect-src 'self' https://vitals.vercel-insights.com https://va.vercel-scripts.com https://api.github.com; form-action 'self'; frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "southforgeai-site.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    { "source": "/products/toolport", "destination": "https://toolport.app", "permanent": true },
    { "source": "/products/toolport/(.*)", "destination": "https://toolport.app", "permanent": true },

    { "source": "/work", "destination": "/", "permanent": true },
    { "source": "/work/(.*)", "destination": "/", "permanent": true },

    { "source": "/blog", "destination": "/", "permanent": false },
    { "source": "/blog/(.*)", "destination": "/", "permanent": false },
    { "source": "/rss.xml", "destination": "/ship.xml", "permanent": false }
  ]
}
